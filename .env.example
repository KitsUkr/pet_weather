# ── Telegram ──────────────────────────────────────────────────────────────────
# Токен від @BotFather
BOT_TOKEN=123456:your_telegram_bot_token_here

# ── База даних (SQLite) ──────────────────────────────────────────────────────
DB_PATH=weather.db

# ── Розсилка ──────────────────────────────────────────────────────────────────
# Час за замовчуванням для /subscribe без аргументу (формат HH:MM, час київський)
DEFAULT_SUB_TIME=08:00

# ── Шрифт (необов'язково) ─────────────────────────────────────────────────────
# Шлях до .ttf з підтримкою кирилиці. Якщо порожньо — використовується
# системний шрифт (DejaVuSans у Docker, Arial у Windows).
FONT_PATH=
